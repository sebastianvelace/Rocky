[Unit]
Description=Rocky Engine (API / WebSocket)
After=network.target

[Service]
Type=simple
User=rocky
WorkingDirectory=/opt/rocky/rocky-engine
EnvironmentFile=-/opt/rocky/.env
ExecStart=/opt/rocky/rocky-engine/venv/bin/python3 -m uvicorn src.main:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
