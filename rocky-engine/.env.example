# Rocky engine local configuration.
#
# Copy this file to `.env` and fill only the integrations you want to use.
# Never commit the real `.env`.

# Required for Llama/Whisper via Groq. Without it Rocky uses fallback responses.
GROQ_API_KEY=

# Optional: structured log verbosity.
ROCKY_LOG_LEVEL=INFO

# Optional: Spotify tools.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: Google Calendar tools.
# Point to a Google service-account or OAuth user JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
