# ==========================================
# ROCKY - VARIABLES DE ENTORNO (Phase 1)
# ==========================================

# 1. Seguridad IPC
# En producción Tauri genera un UUID en cada arranque y lo inyecta al proceso
# de Python. Solo se define manualmente para correr el engine en modo dev
# (sin Tauri).
ROCKY_AUTH_TOKEN=dev_secret_token_12345

# 2. IA: inferencia (Llama 3.3) y voz (Whisper STT) vía Groq
GROQ_API_KEY=gsk_tu_llave_aqui

# 2b. Modelos locales Ollama e investigación controlada
ROCKY_MODEL_PROVIDER=groq
ROCKY_OLLAMA_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434
ROCKY_WEB_ENABLED=true
ROCKY_WORKSPACE_ROOT=
ROCKY_ALLOW_WORKSPACE_READ=true
ROCKY_ALLOW_CALENDAR_READ=true
ROCKY_ALLOW_SPOTIFY_CONTROL=true

# 3. Sistema y observabilidad
ROCKY_LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# 4. Spotify (opcional — https://developer.spotify.com/dashboard)
# Sin credenciales, Rocky responde explicando cómo configurarlo.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# 5. Google Calendar (opcional — JSON de service account o client secrets
#    de OAuth; Rocky detecta el tipo automáticamente)
GOOGLE_APPLICATION_CREDENTIALS=
